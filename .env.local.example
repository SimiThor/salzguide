# SalzGuide – Environment-Variablen (Vorlage)
#
# Setup:  cp .env.local.example .env.local   und echte Werte eintragen.
# .env.local wird NIE committet (siehe .gitignore). Diese Datei enthält nur Keys,
# niemals Werte — sie ist die gemeinsame Referenz im Team.
#
# Neue Variable im Code? Immer HIER mit eintragen (ohne Wert), damit alle wissen,
# dass es sie gibt.

# === Basis ===
# LOKAL: http://localhost:3000
#
# IN VERCEL: am besten GAR NICHT setzen. lib/site-url.ts nimmt dann Vercels eigene
# VERCEL_PROJECT_PRODUCTION_URL — die zeigt immer auf die aktuelle Produktions-Domain und
# wandert beim Umzug von selbst mit. Wer hier trotzdem etwas einträgt, muss es beim
# Domainwechsel daran denken.
#
# WARUM DER HINWEIS SO AUSFÜHRLICH IST: Hier stand mal "Produktion: https://salzguide.com",
# und in Vercel landete "http://localhost:3000". Folge: Der Magic-Link zeigte auf localhost
# (niemand kam auf der echten Seite rein), robots.txt und sitemap.xml auch, und jede Seite
# sagte Google per canonical, ihr Original stehe auf localhost. Kein Fehler, kein Alarm,
# monatelang. lib/site-url.ts verwirft localhost auf Vercel inzwischen — aber der Riegel
# ersetzt das Geländer nicht.
NEXT_PUBLIC_SITE_URL=

# === Supabase (EU / Frankfurt) — PFLICHT, sonst startet die App nicht ===
# Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Nur serverseitig! Umgeht Row Level Security — niemals im Client verwenden.
SUPABASE_SERVICE_ROLE_KEY=

# === Mapbox (Explore-Karte) — PFLICHT für die Karte ===
# mapbox.com -> Account -> Tokens (Public Token, beginnt mit "pk.")
# Dieser Token darf URL-beschränkt sein (nur eigene Domains), er läuft im Browser.
NEXT_PUBLIC_MAPBOX_TOKEN=

# Server-Token fürs KI-Runden-Routing (Optimized Trips). SEPARAT und OHNE URL-Beschränkung:
# serverseitige Aufrufe senden keinen Referer, ein URL-beschränkter Token gäbe 403 -> die
# Runde käme als gerade Linien ohne Start. Eigener Token, geheim halten (kein NEXT_PUBLIC).
MAPBOX_SERVER_TOKEN=

# === Stripe (Membership) ===
#
# Produktionskonto (das echte Geld). Bleibt gesetzt, auch während man mit STRIPE_TEST_MODE
# gerade auf dem Testkonto arbeitet.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
STRIPE_TAX_ENABLED=

# Testkonto (dashboard.stripe.com/test) — komplett getrenntes Konto mit eigenen Keys,
# eigenem Webhook-Signing-Secret und eigenen Preisen. Für den Test-Webhook in Stripe eine
# ZWEITE Endpoint-Adresse (dieselbe URL, Testmodus) anlegen und deren Secret hier eintragen.
STRIPE_SECRET_KEY_TEST=
STRIPE_WEBHOOK_SECRET_TEST=
STRIPE_PRO_PRICE_ID_TEST=

# Umschalter: "true" = Testkonto (Zeilen oben), sonst/leer = Produktion. In Vercel direkt
# editierbar, kein Deploy nötig. Bewusst so herum (leer = Produktion), damit ein vergessenes
# oder falsch geschriebenes Flag nie unbemerkt auf Test statt Produktion läuft.
STRIPE_TEST_MODE=

# === Cloudflare Turnstile (Bot-Schutz am Login) ===
#
# LOKAL: LEER LASSEN. Das ist kein Versehen, sondern der einzige Weg, der funktioniert.
#
# Echte Turnstile-Keys sind bei Cloudflare an Domains gebunden, und localhost steht dort
# nicht drin. Trägt man sie hier ein, schlägt das Widget beim Anmelden fehl, der Server
# blockt (turnstile.ts blockt im Zweifel, absichtlich) — und man sperrt sich auf dem
# eigenen Rechner selbst aus. Genau das ist passiert, und die Suche danach dauerte lang,
# weil nichts kaputt AUSSIEHT: Der Roboter-Check sagt nur, er klappe gerade nicht.
#
# Leer = Gate aus (turnstile.ts:25). Lokal richtig, in Produktion beide setzen.
#
# Wer localhost trotzdem testen will, muss es in der Cloudflare-Widget-Konfiguration als
# erlaubte Domain eintragen. Lohnt nur, wenn man am Bot-Schutz selbst arbeitet.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# === Externe APIs ===
# Wetter läuft über Open-Meteo (kein Key nötig).
# Google Places (Öffnungszeiten)
GOOGLE_PLACES_KEY=
# OpenRouteService (Wanderwege-Snapping) — https://openrouteservice.org/dev
ORS_KEY=

# === E-Mail (Magic-Link, Widerruf-/System-Mails) ===
RESEND_KEY=
# Format: "SalzGuide <no-reply@salzguide.com>" — die Domain muss in Resend
# verifiziert sein, sonst lehnt Resend jeden Versand still ab.
EMAIL_FROM=

# === Claude / Anthropic (KI-Texte im Admin) ===
# https://console.anthropic.com
ANTHROPIC_API_KEY=

# === ElevenLabs (AudioTour) ===
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Stimm-Feintuning (optional, Code nutzt Defaults wenn leer)
ELEVENLABS_STABILITY=
ELEVENLABS_SIMILARITY=
ELEVENLABS_STYLE=
ELEVENLABS_SPEED=
ELEVENLABS_SPEAKER_BOOST=

# === Cron-Endpunkte absichern (frei wählbares langes Secret) ===
CRON_SECRET=

# === Intro-Video-Renderer (/render/intro) absichern ===
# Frei wählbares langes Secret. Schützt die interne 3D-Render-Seite in Produktion
# (?token=...). LOKAL egal: im Dev-Server ist /render/intro ohne Token offen.
RENDER_SECRET=

# === Betriebs-Alarme (Fehler, Missbrauch, ausbleibende Cron-Läufe) ===
#
# Wohin die Alarm-Mails gehen. LEER LASSEN ist in Ordnung: Dann geht es an die Adresse aus
# dem Impressum (LEGAL.email). Eine eigene Adresse lohnt sich, wenn die Alarme woanders
# hinsollen als die Kundenpost, etwa auf ein Postfach, das aufs Handy durchklingelt.
#
# Läuft über denselben Resend-Zugang wie alle anderen Mails (RESEND_KEY oben). Ohne den
# steht alles nur im Logbuch, es geht nichts raus.
OPS_ALERT_EMAIL=

# Logbuch AUCH lokal wirklich schreiben (und mailen). LEER LASSEN.
#
# Es gibt nur EIN Supabase-Projekt. Ohne diesen Riegel landete jeder Fehlversuch vom eigenen
# Rechner als „Kritisch" in derselben Tabelle wie die echten, und man bekäme morgens einen
# Alarm, den man selbst gestern Abend beim Ausprobieren erzeugt hat. Lokal steht ohnehin
# alles in der Konsole.
#
# Auf 1 setzen, wenn man am Meldewesen selbst arbeitet. Der Test-Knopf im Admin
# (/admin/settings/system) schickt auch ohne diese Variable.
OPS_LOCAL=

# === Einmaliger Inhalts-Import von der alten WordPress-Seite ===
#
# Nur für scripts/wp-import (npm run wp:fetch). Die App selbst liest das nie. Nach dem
# Umzug kann der Block hier UND das Passwort in WordPress weg.
#
# Das Anwendungspasswort entsteht in WordPress unter Benutzer -> Profil ->
# Anwendungspasswörter. Es ist KEIN Kontopasswort: eigener Schlüssel, einzeln widerrufbar,
# gilt nur für die REST-Schnittstelle. Mit Leerzeichen eintragen, wie WordPress ihn ausgibt,
# und in Anführungszeichen setzen.
#
# Gebraucht wird ein Konto, das Beiträge BEARBEITEN darf. Grund: Der Abruf läuft über
# context=edit. 40 der 102 Spots liegen hinter Simple Membership, und das Plugin filtert
# the_content — der öffentliche Abruf liefert dort nur den Kauf-Hinweis, und ein
# Anwendungspasswort ändert daran nichts, weil das Plugin seine eigene Sitzung prüft.
# context=edit gibt content.raw zurück, also den Inhalt vor jedem Filter.
WP_USER=
WP_APP_PASSWORD=
WP_BASE_URL=https://www.salzguide.com
