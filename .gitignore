# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/
next-env.d.ts

# production
/build

# Temporäre Arbeitskopien von Claude-Subagenten. Werden nach getaner Arbeit gelöscht,
# hinterlassen aber sonst Geister-Fehler im Editor (eigene tsconfig.json ohne Dateien).
/.claude/worktrees/

# Dieselben Anweisungen nochmal, nur für ein zweites KI-Werkzeug (Codex liest AGENTS.md
# und .agents/, Claude Code liest CLAUDE.md und .claude/). Bewusst NICHT im Repo: AGENTS.md
# ist eine Kopie von CLAUDE.md und war schon nach ein paar Tagen eine Zeile auseinander,
# .agents/skills/verify/SKILL.md ist Byte für Byte die schon committete Fassung. Zwei
# Fassungen derselben Anweisung sind zwei Gelegenheiten, sie unterschiedlich zu machen.
# Wer mit dem zweiten Werkzeug arbeitet, legt sie sich lokal an; sie funktionieren dort
# genauso, sie stehen nur nicht doppelt in der Versionsgeschichte.
/AGENTS.md
/.agents/

# misc
.DS_Store
*.pem
tsconfig.tsbuildinfo

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — never commit secrets
.env
.env*.local
.env.development
.env.production

# vercel
.vercel

# typescript
*.tsbuildinfo

# supabase
/supabase/.temp
/supabase/.branches

# Rollback-Protokolle einmaliger Storage-Migrationen (enthalten konkrete Objektpfade,
# gehören nicht ins Repo; bleiben lokal als Sicherung liegen).
/rollback-*.json

# Lokale Render-Ausgaben des Intro-Skripts (inkl. der Quittung von --deliver)
/intro-*.mp4
/intro-export.json

# Lokaler Cache des einmaligen WordPress-Imports (Rohinhalt der alten Seite,
# enthält auch Pro-Inhalte). Wird per "npm run wp:fetch" jederzeit neu geholt.
/.wp-cache/

# Gesprochene Tour-Texte: Pro-Inhalt, gehoert in die Datenbank, nie ins oeffentliche Repo
/.audio-texte/
